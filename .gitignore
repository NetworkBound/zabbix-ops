# Secrets — never commit
.env
*.env
!.env.example

# Script output
*.csv
!templates/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store

*.bak
*.orig

# Exported templates describe your own estate. Both tools that write here are
# covered: templates.py exports YAML, canon.py exports JSON. Commit deliberately,
# after reading what is in them.
templates/*.yaml
templates/*.json
templates/*.xml
