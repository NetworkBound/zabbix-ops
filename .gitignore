# Secrets — never commit
.env
*.env
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials
credentials.*
secrets.*

# Script output
*.csv
!templates/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store

*.bak
*.orig

# Exported templates describe your own estate. Both tools that write here are
# covered: templates.py exports YAML, canon.py exports JSON. Commit deliberately,
# after reading what is in them.
templates/*.yaml
templates/*.json
templates/*.xml
