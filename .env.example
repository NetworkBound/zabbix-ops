# ---------------------------------------------------------------------------
# homelab-zabbix — configuration
#
#   cp .env.example .env   &&   edit   &&   set -a; . ./.env; set +a
#
# Never commit .env.
# ---------------------------------------------------------------------------

# Full path to the API endpoint, including api_jsonrpc.php.
ZBX_URL=http://10.0.0.20/zabbix/api_jsonrpc.php

# Preferred: a scoped API token (Users -> API tokens -> Create API token).
# Give it a read-only role unless you intend to import templates or close
# problems. When set, ZBX_USER/ZBX_PASS are ignored.
ZBX_TOKEN=

# Fallback: username and password.
ZBX_USER=
ZBX_PASS=

# Used by scripts/install-agent.sh and scripts/bulk-install-agents.sh.
# The address guests should send active-check data to (server or proxy).
ZBX_SERVER=10.0.0.20

# Matched by the auto-registration action; see docs/auto-registration.md.
ZBX_METADATA=Linux

# ---------------------------------------------------------------------------
# Proxmox VE — required by scripts/reconcile.py only.
#
# One block per node; numbering must start at 0 and be contiguous. Nodes do not
# need to be clustered — declare each standalone node separately.
#
# Create a READ-ONLY token on each node:
#   pveum user add zabbix@pve
#   pveum aclmod / --users zabbix@pve --roles PVEAuditor
#   pveum user token add zabbix@pve monitoring --privsep 0
# ---------------------------------------------------------------------------
PVE_0_NAME=pve1
PVE_0_URL=https://10.0.0.10:8006
PVE_0_TOKEN=zabbix@pve!monitoring=00000000-0000-0000-0000-000000000000

# PVE_1_NAME=pve2
# PVE_1_URL=https://10.0.0.11:8006
# PVE_1_TOKEN=zabbix@pve!monitoring=00000000-0000-0000-0000-000000000000

# Set true only if your nodes present a publicly trusted certificate.
PVE_VERIFY_TLS=false

# Host groups reconcile.py should ignore when looking for "orphaned" hosts.
# Kit that is not a Proxmox guest — switches, APs, a UPS, the hypervisors —
# will always look orphaned otherwise.
# EXCLUDE_GROUPS=Homelab/Network Homelab/Infrastructure

# Default name filter for scripts/templates.py export.
# ZBX_TEMPLATE_PREFIX=Homelab
